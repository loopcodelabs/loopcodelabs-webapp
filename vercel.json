{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth/callback(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|auth/callback).*)",
      "destination": "/index.html"
    }
  ]
}
